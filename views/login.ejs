<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('login_title') %> — faceIT</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .auth-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }
    .auth-card {
      width: 380px;
      padding: 36px;
    }
    .auth-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'Rajdhani', sans-serif;
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 28px;
      justify-content: center;
    }
    .auth-title { font-size: 20px; margin-bottom: 6px; text-align: center; }
    .auth-sub { color: var(--text-dim); font-size: 13px; text-align: center; margin-bottom: 24px; }
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-size: 12px;
      color: var(--text-dim);
      margin-bottom: 6px;
      font-weight: 600;
    }
    .form-group input {
      width: 100%;
      background: #0e111f;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 11px 14px;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 14px;
    }
    .form-group input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
    }
    .auth-error {
      background: rgba(244,63,94,0.1);
      border: 1px solid rgba(244,63,94,0.3);
      color: #fca5a5;
      font-size: 13px;
      padding: 10px 14px;
      border-radius: 8px;
      margin-bottom: 16px;
      display: none;
    }
    .auth-footer {
      text-align: center;
      margin-top: 20px;
      font-size: 13px;
      color: var(--text-dim);
    }
    .auth-footer a { color: var(--accent-2); font-weight: 600; }
    .lang-switch {
      display: flex;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    .lang-btn {
      padding: 8px 12px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-faint);
    }
    .lang-btn.active {
      background: rgba(99,102,241,0.2);
      color: #c7d2fe;
    }
    .lang-btn:hover { color: var(--text); }
  </style>
</head>
<body>
  <div class="auth-page">
    <div class="faceit-card auth-card">
      <div class="auth-logo">
        <div class="logo-mark"></div>
        faceIT
      </div>

      <div style="display:flex; justify-content:center; margin-bottom: 20px;">
        <div class="lang-switch">
          <a href="/lang/ru" class="lang-btn <%= currentLang === 'ru' ? 'active' : '' %>">RU</a>
          <a href="/lang/en" class="lang-btn <%= currentLang === 'en' ? 'active' : '' %>">EN</a>
        </div>
      </div>

      <h1 class="auth-title"><%= t('login_title') %></h1>
      <p class="auth-sub"><%= t('login_sub') %></p>

      <div class="auth-error" id="errorBox"></div>

      <form id="loginForm">
        <div class="form-group">
          <label><%= t('label_email') %></label>
          <input type="email" id="email" required autocomplete="email">
        </div>
        <div class="form-group">
          <label><%= t('label_password') %></label>
          <input type="password" id="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn-primary" style="width:100%; justify-content:center;"><%= t('btn_login') %></button>
      </form>

      <div class="auth-footer">
        <%= t('no_account') %> <a href="/register"><%= t('register_link') %></a>
      </div>
    </div>
  </div>

  <script src="/js/login.js"></script>
</body>
</html>