<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <%- include('partials/head', { title: t('tab_matchmaking') }) %>
</head>
<body>

  <%- include('partials/sidebar', { activePage: 'dashboard', currentUser }) %>

  <div class="main">
    <%- include('partials/topbar', { currentUser }) %>

    <div class="content">
      <div class="content-main">

        <section class="faceit-card queue-hero">
          <div class="radar idle" id="radar">
            <div class="radar-ring"></div>
            <div class="radar-ring r2"></div>
            <div class="radar-ring r3"></div>
            <div class="radar-sweep" id="sweep"></div>
            <div class="radar-center">
              <div class="count"><span id="slotCount">0</span><span class="of">/10</span></div>
              <div class="status-label" id="radarLabel"><%= t('idle_label') %></div>
            </div>
            <div id="slots"></div>
          </div>

          <div class="queue-info">
            <div class="queue-eyebrow"><%= t('queue_type') %></div>
            <h1 class="queue-title"><%= t('find_match_title') %></h1>
            <p class="queue-desc"><%= t('find_match_desc') %></p>
            <div class="queue-meta">
              <div>
                <span class="val mono" id="timerVal">00:00</span>
                <span class="lbl"><%= t('wait_time') %></span>
              </div>
              <div>
                <span class="val mono">~2:40</span>
                <span class="lbl"><%= t('avg_time') %></span>
              </div>
              <div>
                <span class="val mono"><%= currentUser.elo %></span>
                <span class="lbl"><%= t('your_elo') %></span>
              </div>
            </div>
            <button class="btn-primary" id="queueBtn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <%= t('btn_find_game') %>
            </button>
          </div>
        </section>

        <section class="faceit-card">
          <div class="section-head">
            <h2><%= t('leaderboard_title') %></h2>
            <span class="sub"><%= t('leaderboard_sub') %></span>
          </div>
          <div class="lb-head">
            <span><%= t('col_rank') %></span>
            <span><%= t('col_player') %></span>
            <span><%= t('col_level') %></span>
            <span style="text-align:right"><%= t('col_elo') %></span>
          </div>

          <% leaderboard.forEach((player, index) => { %>
            <div class="lb-row <%= index === 0 ? 'top1' : '' %>">
              <span class="lb-rank">#<%= index + 1 %></span>
              <span class="lb-player">
                <span class="avatar-frame-neon">
                  <% if (player.avatarUrl) { %>
                    <img src="<%= player.avatarUrl %>" alt="">
                  <% } else { %>
                    <span class="avatar-fallback"><%= player.username.slice(0, 2).toUpperCase() %></span>
                  <% } %>
                </span>
                <%= player.username %>
                <span class="lb-status <%= onlineUserIds.includes(player.id) ? '' : 'offline' %>"></span>
              </span>
              <span class="lb-level">LVL <%= Math.min(10, Math.floor(player.elo / 400) + 1) %></span>
              <span class="lb-elo"><%= player.elo %></span>
            </div>
          <% }) %>
        </section>

      </div>

      <aside class="side-panel">
        <div class="faceit-card party-card">
          <div class="party-head">
            <h3><%= t('party_title') %></h3>
            <span class="party-vs">1/5</span>
          </div>
          <div class="friend-row">
            <span class="avatar-frame-neon"><span class="avatar-fallback"><%= currentUser.username.slice(0, 2).toUpperCase() %></span></span>
            <div>
              <div class="friend-name"><%= currentUser.username %> <%= t('you_suffix') %></div>
              <div class="friend-status online"><%= t('status_online') %></div>
            </div>
          </div>
          <button class="btn-ghost" style="width:100%; margin-top:10px;"><%= t('invite_friend') %></button>
        </div>

        <div class="faceit-card vip-card">
          <h3><%= t('premium_title') %></h3>
          <p><%= t('premium_desc') %></p>
          <button class="btn-premium"><%= t('btn_get_premium') %></button>
        </div>
      </aside>

    </div>
  </div>

	<script>window.APP_TOKEN = "<%= token %>"</script>
	<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
	<script src="/js/dashboard.js"></script>
</body>
</html>